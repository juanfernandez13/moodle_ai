{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "plugins": [],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true

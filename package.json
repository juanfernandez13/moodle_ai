{
  "name": "moodle-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Preparação de cursos Moodle com contrato validado e exportação planejada",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "test": "node --test tests/domain/*.test.ts tests/cli/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "validate:draft": "node src/cli/validate-draft.ts",
    "demo": "npm run validate:draft -- tests/fixtures/course-valid.json",
    "design:css": "npm --prefix docs/design-proposals/glass-owl-v4 run build:css",
    "codegraph:init": "codegraph init .",
    "codegraph:status": "codegraph status",
    "codegraph:serve": "codegraph serve --mcp"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "1.6.2",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  },
  "dependencies": { "zod": "4.6.6" }
}
